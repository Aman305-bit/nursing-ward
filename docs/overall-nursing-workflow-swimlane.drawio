        </mxCell>
        <mxCell id="s6" value="6. Initial nursing assessment&#xa;Vitals, pain, risk, devices, allergies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="785" y="365" width="180" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7. Bedside care documentation&#xa;Vitals, MAR, doctor orders, notes, I/O, safety checklist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;spacing=10;" vertex="1" parent="1">
