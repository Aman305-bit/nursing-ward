        </mxCell>
        <mxCell id="s8" value="8. Monitor unit worklist&#xa;Pending vitals, medicines, orders and tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;spacing=10;" vertex="1" parent="1">
