        <mxCell id="s1" value="1. Patient admitted / transferred&#xa;Bed assigned; appears in nursing queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="65" y="150" width="180" height="72" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. Review new admission&#xa;Check unit, priority and staff availability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="305" y="150" width="180" height="72" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. Assign patient to Unit Nurse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="305" y="255" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. Assign patient to Ward Nurse&#xa;Check nurse availability, skill and acuity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="545" y="255" width="180" height="72" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. Accept patient assignment&#xa;Open patient nursing profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;spacing=10;" vertex="1" parent="1">
