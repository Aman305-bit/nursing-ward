        </mxCell>
        <mxCell id="s10" value="10. Raise issue to Unit Nurse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;spacing=10;" vertex="1" parent="1">
